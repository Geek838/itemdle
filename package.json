{
  "name": "itemdle-server",
  "version": "1.0.0",
  "description": "Backend server for ITEMDLE - fetches dynamic champion builds from mobalytics.gg via Parse.bot API or LeagueBuilds with 24h server-side caching",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "PARSE_API_KEY=test BUILD_SOURCE=leaguebuilds NODE_ENV=test PORT=3001 jest --forceExit"
  },
  "keywords": [
    "league-of-legends",
    "lol",
    "builds",
    "scraping",
    "api"
  ],
  "author": "Geek838",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
