# ITEMDLE Backend Server Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED (Choose one API source)
# ============================================
# Option 1: Parse.bot API Key for Mobalytics (requires API key)
# Get your free API key from: https://parse.bot/marketplace/53405028-f65e-4c87-a55f-80a5b57efc50/mobalytics-gg-api
PARSE_API_KEY=your_parse_bot_api_key_here

# Option 2: Use LeagueBuilds (no API key needed, free)
# Set BUILD_SOURCE=leaguebuilds to use LeagueBuilds instead of Parse.bot
# LeagueBuilds is free, no rate limits, and uses Riot's official match data
# BUILD_SOURCE=leaguebuilds

# ============================================
# OPTIONAL
# ============================================
# Server port (default: 3000)
PORT=3000

# Comma-separated list of allowed CORS origins
# Example: http://localhost:8080,https://itemdle.onrender.com,https://geek838.github.io
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Parse.bot API URL (default: https://api.parse.bot/scraper/e7dd7967-737e-472d-90c0-f106c9882b4e)
PARSE_API_URL=https://api.parse.bot/scraper/e7dd7967-737e-472d-90c0-f106c9882b4e

# Data Dragon API URL (default: https://ddragon.leagueoflegends.com)
DD_API_URL=https://ddragon.leagueoflegends.com

# LeagueBuilds API URL (default: https://leaguebuilds.hopto.org)
LEAGUEBUILDS_URL=https://leaguebuilds.hopto.org

# Build source: 'parsebot' (default if PARSE_API_KEY is set) or 'leaguebuilds'
# To use LeagueBuilds: Set BUILD_SOURCE=leaguebuilds and remove PARSE_API_KEY
# To use Parse.bot: Set PARSE_API_KEY and BUILD_SOURCE will default to 'parsebot'
BUILD_SOURCE=parsebot

# Build cache TTL in milliseconds (default: 86400000 = 24 hours)
BUILD_CACHE_TTL=86400000

# ============================================
# DEPLOYMENT NOTES
# ============================================
# For Render deployment:
# 1. Add all these variables in the Render dashboard under "Environment"
# 2. Set ALLOWED_ORIGINS to include your frontend URL and localhost for testing
# 3. The server will automatically use the environment variables

# For local development:
# 1. Copy this file to .env
# 2. Fill in the required values
# 3. Run: npm install && node server.js
